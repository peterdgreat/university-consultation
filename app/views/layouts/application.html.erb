<!DOCTYPE html>
<html>
  <head>
    <title>UniversityConsultation</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-W6/zv4M+n0YhAd+Ma0vEww5hNFV17lvkH+10p4pGkD8v7XEmULfZCvKlOuAxNxNd" crossorigin="anonymous">
    <%= javascript_importmap_tags %>
  </head>

  <body>
      <p class="notice"><%= notice %></p>
       <p class="alert"><%= alert %></p>
    <%= yield %>

  </body>
</html>
