<!-- app/views/schools/index.html.erb -->
<h1>Schools</h1>

<%= render 'shared/search_form' %>

<table class="table">
  <thead>
    <tr>
      <th>Name</th>
      <th>Course of Study</th>
      <th>Level of Study</th>
      <th>Study Destination</th>
      <th>Fees</th>
      <th>Intake Date</th>
      <th>Duration</th>
      <th>Scholarship Availability</th>
    </tr>
  </thead>
  <tbody>
    <% @schools.each do |school| %>
      <tr>
        <td><%= school.name %></td>
        <td><%= school.course_of_study %></td>
        <td><%= school.level_of_study %></td>
        <td><%= school.study_destination %></td>
        <td><%= school.fees %></td>
        <td><%= school.intake_date %></td>
        <td><%= school.duration %></td>
        <td><%= school.scholarship_availability ? 'Yes' : 'No' %></td>
      </tr>
    <% end %>
  </tbody>
</table>